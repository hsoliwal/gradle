<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.synexia.verification</groupId>
  <artifactId>m3-ast-build-reverse-recipe-proof</artifactId>
  <version>1</version>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <recipe.owner.root>${project.basedir}/../..</recipe.owner.root>
    <m3.dataset>fixture</m3.dataset>
    <m3.crate.name>m3-ast-build-reverse-20261017-${m3.dataset}</m3.crate.name>
    <m3.resources>${project.basedir}/datasets/${m3.dataset}/resources</m3.resources>
    <m3.recipe.name>com.synexia.m3jdk.AstBuildReverse20261017</m3.recipe.name>
    <rewrite.version>8.17.1</rewrite.version>
  </properties>
  <dependencies>
    <dependency><groupId>org.openrewrite</groupId><artifactId>rewrite-java</artifactId><version>${rewrite.version}</version></dependency>
    <dependency><groupId>org.openrewrite</groupId><artifactId>rewrite-java-21</artifactId><version>${rewrite.version}</version><scope>runtime</scope></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.10.2</version><scope>test</scope></dependency>
    <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-simple</artifactId><version>2.0.13</version><scope>test</scope></dependency>
  </dependencies>
  <build>
    <directory>${project.basedir}/target/${m3.dataset}</directory>
    <sourceDirectory>${recipe.owner.root}/src/main/java</sourceDirectory>
    <resources><resource><directory>${m3.resources}</directory></resource></resources>
    <plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-resources-plugin</artifactId><version>3.3.1</version>
        <configuration><overwrite>true</overwrite></configuration>
      </plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version>
        <configuration><includes>
          <include>com/synexia/rewrite/M3HashPinnedJavaSnapshotRecipe.java</include>
          <include>com/synexia/rewrite/M3HashPinnedTextSnapshotRecipe.java</include>
          <include>com/synexia/rewrite/M3ScopeInference.java</include>
          <include>com/synexia/rewrite/M3EditScope.java</include>
        </includes><testIncludes><testInclude>com/synexia/rewrite/M3TaskRecipeTest.java</testInclude></testIncludes>
          <compilerArgs><arg>-Xlint:all</arg><arg>-Werror</arg></compilerArgs></configuration>
      </plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.2.5</version>
        <configuration>
          <failIfNoTests>true</failIfNoTests>
          <includes><include>com/synexia/rewrite/M3TaskRecipeTest.java</include></includes>
          <argLine>-Xmx1536m</argLine>
          <systemPropertyVariables>
            <m3.dataset>${m3.dataset}</m3.dataset>
            <m3.crate.name>${m3.crate.name}</m3.crate.name>
            <m3.recipe.name>${m3.recipe.name}</m3.recipe.name>
            <m3.crate.root>${project.basedir}</m3.crate.root>
            <m3.recipe.owner.root>${recipe.owner.root}</m3.recipe.owner.root>
            <m3.candidate.root>${project.build.directory}/candidate</m3.candidate.root>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
<profile>
  <id>contract</id>
  <properties>
    <m3.contract.python>python3</m3.contract.python>
    <m3.contract.output>${project.build.directory}/receiver-proof</m3.contract.output>
  </properties>
  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>verify-input-sealing-contract</id>
            <phase>verify</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>${m3.contract.python}</executable>
              <arguments><argument>${project.basedir}/contract/test_prepare.py</argument></arguments>
              <environmentVariables><PYTHONDONTWRITEBYTECODE>1</PYTHONDONTWRITEBYTECODE></environmentVariables>
              <timeout>30000</timeout>
            </configuration>
          </execution>
          <execution>
            <id>verify-sdk-receiver-integrity</id>
            <phase>verify</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>${m3.contract.python}</executable>
              <arguments>
                <argument>${project.basedir}/contract/verify_receiver.py</argument>
                <argument>--crate</argument><argument>${project.basedir}</argument>
                <argument>--dataset</argument><argument>${m3.dataset}</argument>
                <argument>--recipe-owner</argument><argument>${recipe.owner.root}</argument>
                <argument>--output</argument><argument>${m3.contract.output}</argument>
              </arguments>
              <environmentVariables><PYTHONDONTWRITEBYTECODE>1</PYTHONDONTWRITEBYTECODE></environmentVariables>
              <timeout>120000</timeout>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</profile>
  </profiles>
</project>
